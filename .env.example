# Application Port
PORT=3000

# MongoDB Connection String
# - For MongoDB Atlas:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/todo-auth?retryWrites=true&w=majority
# - For Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/nestjs-todo

# JWT Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
